# Required: lets the app generate content without each user pasting their own key.
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: enables cloud sync of business profiles and history via Firestore.
# Leave blank to run in local-only mode (users can also paste their own
# Firebase config in-app under Settings > Cloud Sync).
# Must keep the VITE_ prefix - Vite only exposes VITE_-prefixed vars to the
# browser bundle (unlike GEMINI_API_KEY above, which vite.config.ts wires in
# separately). Omitting the prefix here will silently fail in production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

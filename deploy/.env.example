# Copy to ../.env next to docker-compose.yml
# Required: long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Recommended for production: Postgres connection string (Neon). Leave empty for the demo volume store.
DATABASE_URL=
# Browser origins allowed to call the API (comma separated). Use your real https domains in production.
ALLOWED_ORIGINS=http://admin.localhost,http://app.localhost,http://driver.localhost
# Public URLs the web apps call (baked in at build time)
PUBLIC_API_URL=http://api.localhost/api
PUBLIC_REALTIME_URL=http://api.localhost
# Optional: email the ride PIN (Gmail needs an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

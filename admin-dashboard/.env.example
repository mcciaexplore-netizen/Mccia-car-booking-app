# Backend URL when deployed (Vercel). Leave unset locally.
VITE_API_URL=https://your-backend.vercel.app/api

# Geoapify key for map tiles, routing and address search: create one at https://myprojects.geoapify.com
# (restrict it to your website addresses there). Without it the apps use plain OpenStreetMap.
VITE_GEOAPIFY_API_KEY=

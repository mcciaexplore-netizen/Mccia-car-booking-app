# Copy to .env (local) or add these in Vercel > Project > Settings > Environment Variables.

# REQUIRED in production: a long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# REQUIRED on Vercel: Postgres connection string (Neon via the Vercel marketplace). Leave empty locally to use backend/data/*.json.
DATABASE_URL=

# Optional: email the ride PIN. Gmail needs an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=MCCIA Cabs <yourname@gmail.com>
